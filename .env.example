# Copy to .env.local and fill in what you need. .env* is gitignored.
# Every variable here is optional — the site builds and runs without them.
# NEVER commit real values. Rotate anything that has been pasted into a
# plaintext file or shared in chat.

# --- Canonical site origin ---------------------------------------------------
# Used for metadata, canonical URLs, sitemap.xml, and robots.txt.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=https://somokolonlabs.com

# --- Contact form delivery (Resend) -----------------------------------------
# Without RESEND_API_KEY the form logs in development and returns 503 in
# production, rather than silently swallowing enquiries.
# Get a key at https://resend.com, then verify your sending domain.
RESEND_API_KEY=
# Must be an address on a domain you have verified with Resend.
CONTACT_FROM_EMAIL=Somokolon Labs <site@somokolonlabs.com>
# Where enquiries land. Defaults to hello@somokolonlabs.com.
CONTACT_TO_EMAIL=hello@somokolonlabs.com

# --- Website assistant (DeepSeek) --------------------------------------------
# Server-side only. Without DEEPSEEK_API_KEY the chat replies that it's offline.
# DeepSeek bills from a prepaid balance: keep it small and set a low-balance alert.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Replies per day across the whole site, whatever the traffic. Bounds the bill.
CHAT_DAILY_CAP=1500

# --- Shared rate limits (Upstash Redis) --------------------------------------
# Makes the chat limits hold across all serverless instances. Without these the
# counters are per instance. Create a free database at https://upstash.com (or
# add Upstash from the Vercel Marketplace, which sets KV_REST_API_URL/TOKEN
# instead; either pair works). Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Search Console ----------------------------------------------------------
# The token from Google Search Console's "HTML tag" verification method (just
# the content="…" value). Adds the <meta name="google-site-verification"> tag.
GOOGLE_SITE_VERIFICATION=

PORT=5000